# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (Console > Connect). Server-only.
DATABASE_URL=

# Neon Auth (Console > Settings > Auth). Not wired up yet; arrives with the accounts milestone.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Map style. Defaults to OpenFreeMap Positron (free, attribution required).
NEXT_PUBLIC_MAP_STYLE_URL=

# Place search. Defaults to OpenStreetMap Nominatim, fine for development only.
GEOCODER_URL=
GEOCODER_USER_AGENT=

# Listing photos: Neon Object Storage (S3-compatible). Each Neon branch has its own endpoint and credentials.
# Create the bucket "listing-photos" (public_read) on the branch, then a credential with storage:read/write.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=listing-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Show the hard-coded demonstration listings in the finder (badged as demos). Leave unset in production.
BOARDEASE_DEMO_LISTINGS=

# Local development: put DATABASE_URL for a Neon dev branch in .env.development.local so `next dev` never uses main.
# Integration tests read MARKETPLACE_DATABASE_URL (a dev branch) and refuse to run against DATABASE_URL.
MARKETPLACE_DATABASE_URL=
