# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (Console > Connect). Server-only.
DATABASE_URL=

# Neon Auth (Console > Settings > Auth). Not wired up yet; arrives with the accounts milestone.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Map style. Defaults to OpenFreeMap Positron (free, attribution required).
NEXT_PUBLIC_MAP_STYLE_URL=

# Place search. Defaults to OpenStreetMap Nominatim, fine for development only.
GEOCODER_URL=
GEOCODER_USER_AGENT=
